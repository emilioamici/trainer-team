# Variabili pubbliche della build (in GitHub: Settings → Secrets and variables → Actions → Variables).
# Nessun segreto qui dentro: il Client ID OAuth di tipo "Web" è pubblico.
VITE_GOOGLE_CLIENT_ID=
# Necessari per il Google Picker (collegare un atleta/coach al file condiviso con drive.file)
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
